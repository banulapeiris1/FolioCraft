PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=FolioCraft
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Gemini AI: primary CV extractor. Without a key, CVs are parsed with basic rules (much less accurate).
# Never expose to frontend. Application continues to operate deterministically if omitted.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the primary model is overloaded (HTTP 503/429)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
